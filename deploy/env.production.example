# 贝壳云图生产环境变量（复制为服务器上的 /var/lib/beike/.env）
# 不要把填好密钥的文件提交到 Git。

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# 必填：浏览器 Cookie / API 鉴权令牌，务必改成足够长的随机串
LOCAL_ACCESS_TOKEN="请改成随机长令牌"

# 生产环境危险操作（对象存储迁移、连通测试）的管理员令牌。未配置时相关路由返回 403。
ADMIN_ACCESS_TOKEN="请改成随机长令牌"

# 允许浏览器请求覆盖网关 Base URL。生产保持 false，除非明确要开放自定义网关。
ALLOW_CUSTOM_BASE_URL="false"

# 数据目录（数据库 azhuo.db 与 storage/ 都放这里）
AZHUO_DATA_DIR=/var/lib/beike
DATABASE_URL="file:/var/lib/beike/azhuo.db"

# 前端构建产物（pnpm run build:ui 之后）
WEB_DIST_DIR=/opt/beike/apps/web/dist

# 公网访问来源，写成 http://公网IP 或 https://你的域名（逗号分隔多个）
PUBLIC_WEB_ORIGIN="http://127.0.0.1"

# AI 绘图网关
# 网页部署（推荐）：保持以下两项为空。每位用户在网页「设置 → API 服务」自行输入，
# Key 仅保存在该浏览器并随当前请求转发，不会写回此服务器文件。
# 如需由服务器统一托管网关，才填写它们；这会让所有用户共用同一把 Key。
AI_DRAWING_BASE_URL=""
AI_DRAWING_API_KEY=""

# 可选
WANBANG_API_KEY=""
WANBANG_API_SECRET=""
EXTERNAL_SCRAPER_ID=""
EXTERNAL_SCRAPER_SECRET=""
