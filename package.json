{
  "name": "beike-cloud-graph",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --max-old-space-size=2048 --expose-gc ./node_modules/tsx/dist/cli.mjs watch --tsconfig tsconfig.json src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "dev:web": "node tools/scripts/web/dev-web.mjs",
    "start:web": "node tools/scripts/web/start-web.mjs",
    "seed:export": "node tools/scripts/db-maintenance/export-official-seeds.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tools/configs/tsconfig.client.json",
    "typecheck:server": "tsc --noEmit -p tools/configs/tsconfig.server.json",
    "build:ui": "vite build",
    "build": "pnpm run typecheck && pnpm run db:generate && pnpm run build:ui",
    "check": "pnpm run check:root-layout && pnpm run check:structure && pnpm run check:model-catalog && pnpm run check:workshop-statuses && pnpm run typecheck && pnpm run typecheck:client && pnpm run typecheck:server && pnpm run lint && pnpm run lint:unused && pnpm run lint:max-lines && pnpm run lint:boundaries && pnpm run lint:deps && pnpm run lint:secrets && pnpm run build:ui",
    "check:root-layout": "node tools/scripts/quality/check-root-layout.mjs",
    "check:model-catalog": "node tools/scripts/quality/check-model-catalog.mjs",
    "postinstall": "pnpm run db:generate && node tools/scripts/depth/fix-ffmpeg-perms.mjs && node tools/scripts/quality/check-root-layout.mjs",
    "setup:depth-env": "node tools/scripts/depth/fix-ffmpeg-perms.mjs && node tools/scripts/depth/verify-env.mjs",
    "setup:depth-model": "node tools/scripts/depth/setup-depth-model.mjs",
    "clean": "rm -rf tools/build/ui",
    "clean:dev": "pnpm run clean",
    "clean:all": "pnpm run clean:dev && rm -rf node_modules",
    "db:migrate": "tsx --tsconfig tsconfig.json tools/scripts/db-maintenance/migrate-sqlite.mjs",
    "db:deploy": "tsx --tsconfig tsconfig.json tools/scripts/db-maintenance/migrate-sqlite.mjs",
    "db:backup": "node tools/scripts/db-maintenance/backup-sqlite.mjs",
    "db:restore:verify": "node tools/scripts/db-maintenance/verify-sqlite.mjs",
    "lint": "eslint -c tools/configs/eslint.config.mjs",
    "lint:gate": "eslint -c tools/configs/eslint.config.mjs --quiet && pnpm run lint:unused",
    "lint:unused": "node tools/scripts/quality/check-unused.mjs",
    "lint:max-lines": "node tools/scripts/quality/check-max-lines.mjs",
    "lint:boundaries": "node tools/scripts/quality/check-import-boundaries.mjs",
    "lint:secrets": "node tools/scripts/quality/check-secrets.mjs",
    "lint:deps": "depcruise src --config tools/configs/dependency-cruiser.mjs",
    "prepare": "simple-git-hooks",
    "dev": "node tools/scripts/web/dev-web.mjs",
    "start": "node tools/scripts/web/start-web.mjs",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "check:structure": "node tools/scripts/quality/check-structure.mjs",
    "check:workshop-statuses": "node tools/scripts/quality/check-workshop-statuses.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "dependency-cruiser": "^16.10.4",
    "esbuild": "^0.25.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prisma": "5.22.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hono/node-server": "^1.14.4",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-virtual": "^3.14.10",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.15.0",
    "hono": "^4.8.5",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lru-cache": "5.1.1",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "motion": "^12.43.0",
    "ogl": "^1.0.11",
    "quickjs-emscripten": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "unpdf": "^1.7.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@vgpu/adapter-node",
      "webgpu",
      "sharp",
      "@ffmpeg-installer/darwin-arm64",
      "simple-git-hooks"
    ]
  }
}
