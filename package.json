{
  "name": "beike-cloud-graph",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/scripts/web/dev-web.mjs",
    "dev:web": "node tools/scripts/web/dev-web.mjs",
    "dev:ui": "vite --config tools/configs/vite.config.ts --host 127.0.0.1 --port 5173",
    "start": "node tools/scripts/web/start-web.mjs",
    "start:web": "node tools/scripts/web/start-web.mjs",
    "setup:depth-env": "node tools/scripts/depth/fix-ffmpeg-perms.mjs && node tools/scripts/depth/verify-env.mjs",
    "setup:depth-model": "node tools/scripts/depth/setup-depth-model.mjs",
    "build": "pnpm run typecheck && pnpm run build:ui && pnpm run build:api",
    "build:api": "node tools/scripts/web/build-api.mjs",
    "build:ui": "vite build --config tools/configs/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tools/configs/tsconfig.client.json",
    "clean": "node tools/scripts/web/clean.mjs",
    "clean:dev": "pnpm run clean",
    "clean:cache": "node tools/scripts/web/clean.mjs --cache",
    "clean:build": "node tools/scripts/web/clean.mjs --build",
    "clean:all": "node tools/scripts/web/clean.mjs --build --dependencies",
    "check": "pnpm run check:root-layout && pnpm run check:structure && pnpm run check:model-catalog && pnpm run check:workshop-statuses && pnpm run check:skills && pnpm run check:shared-data && pnpm run check:openapi && pnpm run typecheck && pnpm run typecheck:client && pnpm run lint && pnpm run lint:unused && pnpm run lint:explicit-any && pnpm run lint:max-lines && pnpm run lint:boundaries && pnpm run lint:deps && pnpm run check:reachability && pnpm run lint:secrets && pnpm run check:go && pnpm test && pnpm run build:ui && pnpm run build:api",
    "check:root-layout": "node tools/scripts/quality/check-root-layout.mjs",
    "check:structure": "node tools/scripts/quality/check-structure.mjs",
    "check:model-catalog": "node tools/scripts/quality/check-model-catalog.mjs",
    "check:workshop-statuses": "node tools/scripts/quality/check-workshop-statuses.mjs",
    "check:shared-data": "node --import tsx tools/scripts/quality/check-shared-data.mjs",
    "check:openapi": "node tools/scripts/quality/check-openapi.mjs",
    "openapi:write": "node tools/scripts/quality/check-openapi.mjs --write",
    "lint": "eslint -c tools/configs/eslint.config.mjs",
    "lint:gate": "eslint -c tools/configs/eslint.config.mjs --quiet && pnpm run lint:unused",
    "lint:unused": "node tools/scripts/quality/check-unused.mjs",
    "lint:explicit-any": "node tools/scripts/quality/check-explicit-any.mjs",
    "lint:max-lines": "node tools/scripts/quality/check-max-lines.mjs",
    "lint:boundaries": "node tools/scripts/quality/check-import-boundaries.mjs",
    "lint:deps": "depcruise src --config tools/configs/dependency-cruiser.mjs",
    "check:reachability": "node tools/scripts/quality/check-reachability.mjs",
    "lint:secrets": "node tools/scripts/quality/check-secrets.mjs",
    "check:go": "node tools/scripts/quality/check-go.mjs",
    "test": "vitest run --config tools/configs/vitest.config.ts",
    "db:migrate": "node tools/scripts/db-maintenance/migrate-sqlite.mjs",
    "db:deploy": "node tools/scripts/db-maintenance/migrate-sqlite.mjs",
    "db:backup": "node tools/scripts/db-maintenance/backup-sqlite.mjs",
    "db:restore:verify": "node tools/scripts/db-maintenance/verify-sqlite.mjs",
    "seed:export": "node tools/scripts/db-maintenance/export-official-seeds.mjs",
    "postinstall": "node tools/scripts/depth/fix-ffmpeg-perms.mjs && node tools/scripts/quality/check-root-layout.mjs",
    "prepare": "simple-git-hooks",
    "media:thumbnails": "node tools/scripts/web/build-inspiration-thumbnails.mjs",
    "skills:build": "node --import tsx tools/scripts/skills/build-skill-packages.mjs --write",
    "check:skills": "node --import tsx tools/scripts/skills/build-skill-packages.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsrepo": "^3.8.1",
    "openapi-typescript": "^7.13.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^22"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-virtual": "^3.14.10",
    "gsap": "^3.15.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "motion": "^12.43.0",
    "openapi-fetch": "^0.17.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vgpu": "^0.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "simple-git-hooks"
    ],
    "patchedDependencies": {
      "@hugeicons/core-free-icons@4.3.4": "tools/configs/patches/@hugeicons__core-free-icons@4.3.4.patch"
    }
  }
}
