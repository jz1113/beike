{
  "name": "beike-cloud-graph",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*",
    "db/*"
  ],
  "scripts": {
    "dev:api": "node --max-old-space-size=2048 --expose-gc ./node_modules/tsx/dist/cli.mjs watch --tsconfig tsconfig.json app/api/src/index.ts",
    "dev:ui": "pnpm --filter @beike/web run dev",
    "dev:desktop": "node works/scripts/desktop/dev-desktop.mjs",
    "desktop:status": "node works/scripts/desktop/desktop-status.mjs",
    "desktop:stop": "node works/scripts/desktop/desktop-stop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config works/configs/vitest.config.ts",
    "test:watch": "vitest --config works/configs/vitest.config.ts",
    "test:e2e": "playwright test -c works/configs/playwright.config.ts",
    "build:ui": "pnpm --filter @beike/web run build",
    "build": "pnpm run typecheck && pnpm --filter @beike/prisma run postinstall && pnpm run build:ui",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:unused && pnpm run test && pnpm run build:ui",
    "check:desktop": "cargo check --manifest-path desktop/Cargo.toml",
    "check:root-layout": "node works/scripts/check-root-layout.mjs",
    "postinstall": "pnpm --filter @beike/prisma run postinstall && node works/scripts/depth/fix-ffmpeg-perms.mjs && node works/scripts/check-root-layout.mjs",
    "setup:depth-env": "node works/scripts/depth/fix-ffmpeg-perms.mjs && python3 works/scripts/depth/infer_video_depth.py --check-env && node works/scripts/depth/verify-env.mjs",
    "setup:depth-model": "node works/scripts/depth/setup-depth-model.mjs",
    "clean": "rm -rf desktop/target app/web/dist dist",
    "clean:sidecar": "rm -rf desktop/binaries/node-*",
    "clean:dev": "pnpm run clean && pnpm run clean:sidecar",
    "clean:all": "pnpm run clean:dev && rm -rf node_modules",
    "pack:source": "node works/scripts/pack-source.mjs",
    "pack:zip": "node works/scripts/pack-source.mjs --zip --keep-env",
    "db:clean-assets": "tsx works/scripts/db-maintenance/cleanDirtyAssetLibrary.ts",
    "db:compact-images": "tsx works/scripts/db-maintenance/compactAssetImages.ts",
    "agent:stats": "node works/scripts/agent-stats.mjs",
    "desktop:sidecar": "node works/scripts/desktop/ensure-desktop-sidecar.mjs",
    "lint": "eslint -c works/configs/eslint.config.mjs",
    "lint:gate": "eslint -c works/configs/eslint.config.mjs --quiet && pnpm run lint:unused",
    "desktop:prepare": "pnpm run typecheck && node works/scripts/desktop/prepare-desktop-bundle.mjs",
    "tauri": "tauri",
    "tauri:dev": "node works/scripts/desktop/ensure-desktop-sidecar.mjs && node works/scripts/desktop/tauri-dev.mjs",
    "tauri:build": "pnpm run lint:gate && pnpm run typecheck && tauri build --config desktop/tauri.conf.json",
    "tauri:build:windows": "tauri build --config desktop/tauri.conf.json --bundles nsis",
    "tauri:release": "node works/scripts/desktop/tauri-release.mjs",
    "audit:source": "node works/scripts/quality/source-audit.mjs",
    "lint:unused": "node works/scripts/quality/check-unused.mjs"
  },
  "tauri": {
    "path": "desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^20",
    "esbuild": "^0.25.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4",
    "prisma": "5.22.0",
    "fake-indexeddb": "^6.0.0",
    "@eslint/js": "^9.39.5"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.20.2 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@vgpu/adapter-node",
      "esbuild",
      "prisma",
      "sharp",
      "webgpu"
    ]
  }
}
