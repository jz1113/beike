{
  "name": "beike-cloud-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx server/index.ts",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "dev:desktop": "node tools/scripts/dev-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:ui": "vite build",
    "build": "npm run typecheck && prisma generate && vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:ui",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml",
    "postinstall": "prisma generate",
    "clean": "rm -rf src-tauri/target dist",
    "clean:sidecar": "rm -rf src-tauri/binaries/node-*",
    "clean:dev": "npm run clean && npm run clean:sidecar",
    "clean:all": "npm run clean:dev && rm -rf node_modules",
    "pack:source": "node tools/scripts/pack-source.mjs",
    "desktop:sidecar": "node tools/scripts/ensure-desktop-sidecar.mjs",
    "desktop:prepare": "node tools/scripts/prepare-desktop-bundle.mjs",
    "tauri": "tauri",
    "tauri:dev": "node tools/scripts/ensure-desktop-sidecar.mjs && node tools/scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@hono/node-server": "^1.14.4",
    "@prisma/client": "^5.22.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "hono": "^4.8.5",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "motion": "^13.1.0",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "unpdf": "^1.7.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2.9.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.25.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "@playwright/test": "^1.53.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
