# 贝壳云图 · 环境变量示例（复制为 .env 后按需填写）

# --- API 服务 ---
PORT=3000
HOSTNAME=127.0.0.1
LOCAL_ACCESS_TOKEN=azhuo-local-dev
# ADMIN_ACCESS_TOKEN=your-admin-token

# --- 数据库（相对于 工程/packages/prisma/schema.prisma 的路径） ---
DATABASE_URL=file:./dev.db

# --- AI 绘图网关 ---
AI_DRAWING_API_KEY=
AI_DRAWING_BASE_URL=https://api.openai.com/v1

# --- 万邦采集 ---
WANBANG_API_KEY=
WANBANG_API_SECRET=

# --- 社媒解析 (APIA) ---
# 可在「设置 -> API 服务 -> APIA」中填写并保存，桌面端会自动注入到进程环境变量
EXTERNAL_SCRAPER_ID=
EXTERNAL_SCRAPER_SECRET=

# --- 助手精选技能库（可选）---
# 远程精选索引 JSON（须为 GitHub raw / api 白名单域名）；失败时回退内置索引
# ASSISTANT_SKILLS_INDEX_URL=https://raw.githubusercontent.com/org/repo/main/skills-index.json

# --- Vite 构建（可选）---
# VITE_API_BASE=
# VITE_APP_ACCESS_TOKEN=

# --- 提示词资产反推（受控并发，可选）---
# Pass1 分片/补调并发度（默认 2，上限 4）
# ASSET_DECONSTRUCT_CONCURRENCY=2
# 同时在飞的视觉 API 请求数（默认 2，上限 6）
# ASSET_DECONSTRUCT_MAX_INFLIGHT=2

# --- 深度视频（可选）---
# FFMPEG_PATH=
# FFPROBE_PATH=
# DEPTH_VIDEO_PYTHON=python3
# DEPTH_VIDEO_FORCE_STUB=1
# AZHUO_DATA_DIR=


# Layer decomposition: official Ark credentials (independent of the chat/image gateway).
# ARK_LAYER_API_KEY=
# ARK_LAYER_MODEL=doubao-seedream-5-0-pro-260628
# Optional gateway model override; defaults to the confirmed decomposition model.
# LAYER_GATEWAY_MODEL=seedream-v5-pro/layer-decomposition
