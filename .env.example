# 贝壳云图 · 环境变量示例（复制为 .env 后按需填写）

# --- API 服务 ---
PORT=3000
HOSTNAME=127.0.0.1
LOCAL_ACCESS_TOKEN=azhuo-local-dev
# ADMIN_ACCESS_TOKEN=your-admin-token

# --- 数据库 ---
DATABASE_URL=file:./prisma/dev.db

# --- AI 绘图网关 ---
AI_DRAWING_API_KEY=
AI_DRAWING_BASE_URL=https://api.openai.com/v1

# --- 万邦采集 ---
WANBANG_API_KEY=
WANBANG_API_SECRET=

# --- Vite 构建（可选）---
# VITE_API_BASE=
# VITE_APP_ACCESS_TOKEN=

# --- 桌面 sidecar（Rust 自动注入，一般无需手填）---
# DESKTOP_SHELL=1
# AZHUO_DATA_DIR=
