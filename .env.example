# ==============================================================================
# 贝壳云图 (Beike Cloud Graph) - 环境变量示例配置
# ==============================================================================
# 复制本文件为 .env 并填入实际值使用：
# cp .env.example .env
#
# 注意：在桌面端运行中，部分第三方服务的 API Key 也可在客户端内
# 「设置 -> 服务接口配置」中直接录入并保存至本地加密存储，无需在此硬编码。
# ==============================================================================

# 本地 SQLite 数据库文件路径（相对于 db/prisma 目录）
DATABASE_URL="file:./dev.db"

# API 服务鉴权令牌（用于桌面壳与 sidecar API 间的内部通信）
LOCAL_ACCESS_TOKEN="azhuo-local-dev"

# 生产环境危险操作（对象存储迁移、连通测试）的管理员令牌。
# 非开发、非桌面壳时必须配置，否则相关路由返回 403。
# ADMIN_ACCESS_TOKEN=""

# 允许请求覆盖网关 Base URL。生产默认拒绝；桌面壳会自动设为 true。
# ALLOW_CUSTOM_BASE_URL="false"

# 公网部署时填写浏览器访问来源（http://公网IP 或 https://域名，逗号分隔）
# PUBLIC_WEB_ORIGIN="http://127.0.0.1"
# 生产静态托管目录（pnpm run start:web 时使用）
# WEB_DIST_DIR="./tools/build/ui"
# HOSTNAME="127.0.0.1"
# PORT="3000"
# AZHUO_DATA_DIR=""

# 万邦接口 (用于京东/淘宝等电商详情解析)
WANBANG_API_KEY=""
WANBANG_API_SECRET=""

# 外站抓取服务 (用于通用网页/图文解析)
EXTERNAL_SCRAPER_ID=""
EXTERNAL_SCRAPER_SECRET=""

# AI 绘图 / 视觉大模型网关
AI_DRAWING_BASE_URL="https://ai.comfly.org"
AI_DRAWING_API_KEY=""

# (可选) 私有 S3 / 对象存储配置 (若未配置则默认持久化于本地桌面存储目录)
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_DOMAIN=""
