{
  "extends": "../../works/configs/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "noEmit": true,
    "paths": {
      "@beike/server-kit": [
        "./src/index.ts"
      ],
      "@beike/server-kit/*": [
        "./src/*"
      ],
      "@beike/domain": [
        "../domain/src/index.ts"
      ],
      "@beike/domain/*": [
        "../domain/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
