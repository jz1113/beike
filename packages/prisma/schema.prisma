generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 采集的商品记录
model Product {
  id          String   @id @default(cuid())
  workspaceId String   @default("legacy")
  platform    String   // jd, taobao, external
  itemId      String?  // num_iid 或分享链接
  title       String?
  picUrl      String?  // 封面图
  detailUrls  String?  // JSON字符串存储的图集列表
  createdAt   DateTime @default(now())
  
  // 关联的生图任务
  tasks       ImageTask[]

  @@unique([workspaceId, platform, itemId])
  @@index([workspaceId])
  @@index([itemId])
  @@index([createdAt])
}

// 生图任务记录
model ImageTask {
  id          String   @id @default(cuid())
  workspaceId String   @default("legacy")
  
  // 关联商品（可选，也可能直接填提示词生成）
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  // 提示词相关
  prompt      String
  
  // 第三方任务追踪
  taskId      String?  // 第三方平台返回的 async task_id
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, SUCCESS, FAILURE
  resultUrl   String?  // 成功生成的图片地址
  failReason  String?
  
  // 模型与生成规格
  model       String?
  mediaType   String?  @default("image") // image, video
  size        String?
  quality     String?
  idempotencyKey String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, taskId])
  @@index([workspaceId])
  @@index([status, createdAt])
  @@index([status])
  @@index([productId])
  @@index([createdAt])
  @@index([mediaType])
  @@index([idempotencyKey])
}

// 提示词生成历史记录
model PromptRecord {
  id                 String   @id @default(cuid())
  workspaceId String   @default("legacy")
  productId          String?
  productTitle       String?
  productFingerprint String?
  modelUsed          String?
  styleName          String?
  promptsJson        String   // 存储生成的分镜 JSON 数组
  createdAt          DateTime @default(now())

  @@index([workspaceId])
  @@index([productId])
  @@index([createdAt])
}

// 电商多品类自定义爆款风格配方
model StyleRecipe {
  id            String   @id @default(cuid())
  workspaceId String   @default("legacy")
  name          String   // 风格名称，如 "小红书爆款奶油风桌搭"
  category      String   @default("general") // digital_3c, beauty_care, fashion_apparel, home_living, food_beverage, mother_pets, jewelry_luxury, general 等
  tag           String?  // 标签，如 "暖光漫射 · 极简桌搭"
  desc          String?  // 风格特点中文描述
  promptSnippet String   // AI 逆向提炼的标准中文提示词骨架
  coverUrl      String?  // 封面参考图
  sampleImages  String?  // JSON 存储的全部参考图 URL 数组
  sourceUrl     String?  // 抓取的小红书/抖音原帖链接 (可选)
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId])
  @@index([category])
  @@index([isFavorite])
  @@index([createdAt])
}

// AI 助手对话会话（权威持久化，防崩溃丢失）
model AssistantThread {
  id           String   @id
  workspaceId String   @default("legacy")
  title        String   @default("新对话")
  messagesJson  String   @default("[]")
  // 会话级自动批准的工具白名单（JSON 数组）
  allowedToolsJson String @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([updatedAt])
  @@index([createdAt])
}

// AI 助手 Turn 持久化（服务端权威状态）
model AssistantTurn {
  id             String    @id  // turn_${timestamp}_${random}，与服务端生成一致
  workspaceId String   @default("legacy")
  threadId       String
  model          String?
  status         String    @default("running")  // running|completed|interrupted|failed|awaiting_approval
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  usageInputTokens  Int?
  usageOutputTokens Int?
  snapshotJson   String    @default("{}")  // AssistantTurn JSON
  items          AssistantTurnItem[]

  @@index([workspaceId])
  @@index([threadId])
  @@index([status])
}

// AI 助手 Turn Item 持久化
model AssistantTurnItem {
  id              String    @id
  workspaceId String   @default("legacy")
  turnId         String
  turn           AssistantTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  kind           String    // agentMessage|agentReasoning|toolCall|toolResult|approvalRequest
  status         String    // running|done|error|cancelled
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  content        String    @default("")
  reasoning      String    @default("")
  toolName       String?
  displayName    String?
  argsJson       String    @default("{}")
  summary        String?
  actionJson     String?
  visualImagesJson String?
  metaJson       String    @default("{}")

  @@index([workspaceId])
  @@index([turnId])
}

// 1. 场景资产库
model SceneAsset {
  id                 String   @id @default(cuid())
  workspaceId String   @default("legacy")
  title              String   // 场景标题，如 "苏式园林月亮门雕花木窗棂"
  description        String   // 场景空间与环境肌理详细中文描述
  lighting           String   // 采光系统与物理阴影描述
  category           String   @default("general") // chinese_style, luxury_modern, casual_street, vacation_nature, commuting_car, home_living, minimal_office 等
  spatialType        String   @default("indoor_room") // indoor_room, outdoor_nature, car_interior, desk_office, tea_space, street 等
  suitableCategories String   @default("[]") // 适配商品品类 JSON 数组: ["hairpin", "jade", "ancient_gold"]
  tags               String   @default("") // 逗号分隔标签: "新中式, 园林窗棂, 自然采光"
  coverUrl           String?  // 提取来源代表图
  sourceImages       String?  // 来源图集 JSON 数组
  reversePrompt      String?  // 可直接生图的完整正向提示词
  dimensions         String?  // 八维分析 JSON
  sourceImageIndex   Int?     // 对应图集第几张
  imageType          String?  // photography | landscape | general
  provenance         String   @default("manual") // deconstructed | seed | manual
  usageCount         Int      @default(0) // 调用次数
  isFavorite         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  albumId            String?
  productCategoryIds String   @default("[]")
  isUniversal        Boolean  @default(false)
  actions            ActionAsset[]

  @@index([workspaceId])
  @@index([category])
  @@index([spatialType])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([albumId])
  @@index([isFavorite(sort: Desc), usageCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "SceneAsset_library_order_idx")
}

// 2. 穿搭 OOTD 资产库
model OutfitAsset {
  id                 String   @id @default(cuid())
  workspaceId String   @default("legacy")
  title              String   // 穿搭标题，如 "温柔素雅奶白真丝盘扣开衫"
  top                String   // 上装描述
  bottom             String   // 下装描述
  shoes              String?  // 鞋履
  colorPalette       String?  // 配色方案（如 "奶白 + 浅青（高显白）"）
  category           String   @default("general") // chinese, modern_chic, casual, vintage, business 等
  suitableCategories String   @default("[]") // 适配商品品类 JSON 数组
  tags               String   @default("") // 标签
  coverUrl           String?
  sourceImages       String?  // 来源图集 JSON 数组
  reversePrompt      String?
  dimensions         String?
  sourceImageIndex   Int?
  imageType          String?
  provenance         String   @default("manual")
  usageCount         Int      @default(0)
  isFavorite         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  albumId            String?
  productCategoryIds String   @default("[]")
  isUniversal        Boolean  @default(false)

  @@index([workspaceId])
  @@index([category])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([albumId])
  @@index([isFavorite(sort: Desc), usageCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "OutfitAsset_library_order_idx")
}

// 3. 动作姿态资产库
model ActionAsset {
  id               String      @id @default(cuid())
  workspaceId String   @default("legacy")
  title            String      // 动作标题，如 "45度侧颜发髻微风半身抓拍"
  action           String      // 具体人体动作、手势依托、物理接触点描述
  shotType         String      // 景别: half_body, profile_45, macro_detail, lifestyle_interaction 等
  spatialType      String      @default("general") // sitting, standing, walking, leaning, car_seated, macro, general
  camera           String?     // 推荐镜头焦段
  suitableAnatomy  String      @default("[]") // 适配解剖学品类: ["hairpin", "earring", "necklace", "bracelet", "ring", "bag"]
  tags             String      @default("")
  coverUrl         String?
  sourceImages     String?     // 来源图集 JSON 数组
  reversePrompt    String?
  dimensions       String?
  sourceImageIndex Int?
  imageType        String?
  provenance       String      @default("manual")
  sceneId          String?     // 所属场景（置景分镜包归属）
  shotOrder        Int         @default(0) // 分镜排序 1~4
  usageCount       Int         @default(0)
  isFavorite       Boolean     @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  albumId            String?
  productCategoryIds String   @default("[]")
  isUniversal        Boolean  @default(false)
  scene            SceneAsset? @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([shotType])
  @@index([spatialType])
  @@index([sceneId])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([albumId])
  @@index([isFavorite(sort: Desc), usageCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "ActionAsset_library_order_idx")
}

// 4. 人物博主资产库
model PersonaAsset {
  id          String   @id @default(cuid())
  workspaceId String   @default("legacy")
  name        String   // 如 "小红书顶流清纯名媛风博主"
  description String   // 详细外貌特征、五官骨相、发型发量、肤质毛孔描述
  tags             String   @default("") // 标签
  avatarUrl        String?
  sourceImages     String?  // 来源图集 JSON 数组
  reversePrompt    String?
  dimensions       String?
  sourceImageIndex Int?
  imageType        String?
  provenance       String   @default("manual")
  usageCount       Int      @default(0)
  isFavorite       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  albumId            String?
  productCategoryIds String   @default("[]")
  isUniversal        Boolean  @default(false)

  @@index([workspaceId])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([albumId])
  @@index([isFavorite(sort: Desc), usageCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "PersonaAsset_library_order_idx")
}

// 6. 完整反推提示词资产库（以内容图组为母本；旧单图记录保持兼容）
model FullPromptAsset {
  id                 String   @id @default(cuid())
  workspaceId String   @default("legacy")
  title              String   // 短标题
  albumName          String?  // 所属图集/套组名称，如 "PROD_454-小蛋糕的作用是通往幸福快乐"
  reversePromptZh    String   // 完整中文正向生图提示词
  reversePromptEn    String?  // 完整英文生图提示词
  dimensions         String?  // 九维分析 JSON 字符串
  imageType          String?  // photography | landscape | general 等
  sourceImageIndex   Int?     // 图集第几张 (1-based)
  sourceImageIndices String?  // 图组包含的来源图序号 JSON，如 [1,2,3,4]
  groupIndex         Int?     // 同一图集内的图组序号 (1-based)
  contentSummary     String?  // 整条外站内容的简明总结
  architectureSummary String? // 固定不替换的图组架构：镜头节奏、动作、出镜规则
  replaceableSlots   String?  // 图组级可替换槽位 JSON（人物/穿搭/场景）
  shotPromptsJson    String?  // 图组逐镜结构化提示词 JSON，可直接载入工坊
  coverUrl           String?  // 来源单图缩略图
  sourceImages       String?  // 来源整套图集 URL JSON 数组
  hasHuman           Boolean  @default(true)
  shotFraming        String?  // close_up | medium_full_body | profile_half_body 等
  productFrameRatio  Int?     // 商品画幅占比
  sceneSummary       String?  // 场景摘要
  outfitSummary      String?  // 穿搭摘要
  actionSummary      String?  // 动作摘要
  personaSummary     String?  // 人设摘要
  tags               String   @default("") // 提取标签
  category           String   @default("general")
  provenance         String   @default("deconstructed")
  usageCount         Int      @default(0)
  isFavorite         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  albumId            String?
  productCategoryIds String   @default("[]")
  isUniversal        Boolean  @default(false)

  @@index([workspaceId])
  @@index([category])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([albumName])
  @@index([albumId])
  @@index([albumId, groupIndex])
  @@index([isFavorite(sort: Desc), usageCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "FullPromptAsset_library_order_idx")
}

model AssetProductCategory {
  id       String  @id @default(cuid())
  workspaceId String   @default("legacy")
  name     String
  parentId String?
  position Int     @default(0)
  aliases  String  @default("[]")
  keywords String  @default("[]")
  anatomy  String  @default("[]")
  parent   AssetProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children AssetProductCategory[] @relation("CategoryTree")
  albums   PromptAlbum[]

  @@index([workspaceId])
  @@index([parentId, position])
}

model PromptAlbum {
  id                String   @id @default(cuid())
  workspaceId String   @default("legacy")
  name              String
  sourceKey         String
  productCategoryId String?
  createdAt         DateTime @default(now())
  productCategory   AssetProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, sourceKey])
  @@index([workspaceId])
  @@index([productCategoryId])
}

model WorkshopWorkspace {
  id           String @id
  workspaceId String   @default("legacy")
  revision     Int    @default(1)
  snapshotJson String
  updatedAt    String

  @@index([workspaceId])
}

model WorkshopBatch {
  id              String @id
  workspaceId String   @default("legacy")
  name            String
  status          String
  revision        Int    @default(1)
  snapshotJson    String
  createdAt       String
  updatedAt       String
  legacyRecovered Boolean @default(false)

  @@index([workspaceId])
  @@index([updatedAt])
}

model WorkshopBatchState {
  id               String @id
  workspaceId String   @default("legacy")
  activeBatchId    String?
  legacyMigratedAt String?

  @@unique([workspaceId])
}

model DeconstructReview {
  id        String @id
  workspaceId String   @default("legacy")
  albumName String
  payload   String
  status    String @default("pending")
  createdAt String

  @@index([workspaceId])
}

model PromptImportSource {
  workspaceId String   @default("legacy")
  sourceKey   String
  requestId   String
  state       String
  albumName   String   @default("")
  albumId     String?
  updatedAt   String

  @@id([workspaceId, sourceKey])
}

model PromptAssetRegistry {
  id              String   @id @default(cuid())
  workspaceId String   @default("legacy")
  assetType       String
  sourceAssetId   String
  status          String   @default("draft")
  version         Int      @default(1)
  provenance      String   @default("manual")
  sourceRef       String?
  qualityScore    Float?
  confidence      Float?
  publishedAt     DateTime?
  disabledReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, assetType, sourceAssetId])
  @@index([workspaceId])
  @@index([assetType, status])
  @@index([qualityScore])
}

model PromptAssetCategoryLink {
  id         String @id @default(cuid())
  workspaceId String   @default("legacy")
  assetId    String
  categoryId String
  scope      String @default("suitable")

  @@unique([workspaceId, assetId, categoryId, scope])
  @@index([workspaceId])
  @@index([categoryId])
}

model PromptAssetUsageEvent {
  id         String   @id @default(cuid())
  workspaceId String   @default("legacy")
  assetId    String
  batchId    String
  productId  String?
  taskId     String?
  eventType  String
  createdAt  DateTime @default(now())
  metadata   String   @default("{}")

  @@index([workspaceId])
  @@index([assetId, eventType, createdAt])
  @@index([batchId])
}

model WorkshopOutputReview {
  id                   String   @id @default(cuid())
  workspaceId String   @default("legacy")
  batchId              String
  productId            String
  taskId               String
  decision             String
  productFidelityScore Int?
  compositionScore     Int?
  aestheticScore       Int?
  consistencyScore     Int?
  reasonCodesJson      String   @default("[]")
  note                 String?
  createdAt            DateTime @default(now())

  @@index([workspaceId])
  @@index([batchId, productId])
  @@index([taskId])
}

model WorkshopPipelineRun {
  id              String   @id @default(cuid())
  workspaceId String   @default("legacy")
  batchId         String
  kind            String
  status          String
  inputRevision   Int      @default(0)
  totalTasks      Int      @default(0)
  completedTasks  Int      @default(0)
  successTasks    Int      @default(0)
  failedTasks     Int      @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  errorSummary    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
  @@index([batchId, status])
}
