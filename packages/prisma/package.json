{
  "name": "@beike/prisma",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema and migrations for 贝壳云图",
  "scripts": {
    "postinstall": "prisma generate --schema schema.prisma",
    "db:push": "prisma db push --schema schema.prisma",
