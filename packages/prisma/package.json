{
  "name": "@beike/prisma",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema and migrations for 贝壳云图",
  "scripts": {
    "postinstall": "prisma generate --schema schema.prisma",
    "db:push": "prisma db push --schema schema.prisma",
    "db:migrate": "prisma migrate dev --schema schema.prisma",
    "db:deploy": "prisma migrate deploy --schema schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
