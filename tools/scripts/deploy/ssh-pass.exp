#!/usr/bin/expect -f
set timeout -1
if {![info exists env(SSHPASS)] || $env(SSHPASS) eq ""} {
  puts stderr "SSHPASS 未设置"
  exit 3
}
log_user 1
match_max 100000
spawn {*}$argv
expect {
  "Are you sure you want to continue connecting" { send -- "yes\r"; exp_continue }
  -re {[Pp]assword:} { send -- "$env(SSHPASS)\r" }
}
expect eof
set waitStatus [wait]
if {[llength $waitStatus] >= 4} {
  exit [lindex $waitStatus 3]
}
exit 0
