{
  "extends": "./tools/configs/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@client/*": [
        "./src/client/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tools/configs/*.ts",
    "jsrepo.config.mts"
  ],
  "exclude": [
    "node_modules",
    "tools/build",
    ".local"
  ]
}
