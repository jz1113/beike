{
  "extends": "./tools/configs/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ],
      "@beike/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@beike/domain/*": [
        "./packages/domain/src/*"
      ],
      "@beike/server-kit": [
        "./packages/server-kit/src/index.ts"
      ],
      "@beike/server-kit/*": [
        "./packages/server-kit/src/*"
      ],
      "@beike/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@beike/contracts/*": [
        "./packages/contracts/src/*"
      ]
    }
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/src/vite-env.d.ts",
    "apps/api/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "packages/server-kit/src/**/*.ts",
    "packages/contracts/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
