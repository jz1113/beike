{
  "extends": "./works/configs/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./app/web/src/*"
      ],
      "@beike/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@beike/domain/*": [
        "./packages/domain/src/*"
      ],
      "@beike/server-kit": [
        "./packages/server-kit/src/index.ts"
      ],
      "@beike/server-kit/*": [
        "./packages/server-kit/src/*"
      ],
      "@beike/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@beike/contracts/*": [
        "./packages/contracts/src/*"
      ]
    }
  },
  "include": [
    "app/web/src/**/*.ts",
    "app/web/src/**/*.tsx",
    "app/web/src/vite-env.d.ts",
    "app/api/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "packages/server-kit/src/**/*.ts",
    "packages/contracts/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "works/e2e",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest.config.ts",
    "works/configs/vitest.config.ts",
    "playwright.config.ts",
    "works/configs/playwright.config.ts"
  ]
}
