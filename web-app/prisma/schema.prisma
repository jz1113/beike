generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 采集的商品记录
model Product {
  id          String   @id @default(cuid())
  platform    String   // jd, taobao, external
  itemId      String?  // num_iid 或分享链接
  title       String?
  picUrl      String?  // 封面图
  detailUrls  String?  // JSON字符串存储的图集列表
  createdAt   DateTime @default(now())
  
  // 关联的生图任务
  tasks       ImageTask[]
}

// 生图任务记录
model ImageTask {
  id          String   @id @default(cuid())
  
  // 关联商品（可选，也可能直接填提示词生成）
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  
  // 提示词相关
  prompt      String
  
  // 第三方任务追踪
  taskId      String?  @unique // 第三方平台返回的 async task_id
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, SUCCESS, FAILURE
  resultUrl   String?  // 成功生成的图片地址
  failReason  String?
  
  // 模型与生成规格
  model       String?
  mediaType   String?  @default("image") // image, video
  size        String?
  quality     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 提示词生成历史记录
model PromptRecord {
  id                 String   @id @default(cuid())
  productId          String?
  productTitle       String?
  productFingerprint String?
  modelUsed          String?
  styleName          String?
  promptsJson        String   // 存储生成的分镜 JSON 数组
  createdAt          DateTime @default(now())
}

// 电商多品类自定义爆款风格配方
model StyleRecipe {
  id            String   @id @default(cuid())
  name          String   // 风格名称，如 "小红书爆款奶油风桌搭"
  category      String   @default("general") // digital_3c, beauty_care, fashion_apparel, home_living, food_beverage, mother_pets, jewelry_luxury, general 等
  tag           String?  // 标签，如 "暖光漫射 · 极简桌搭"
  desc          String?  // 风格特点中文描述
  promptSnippet String   // AI 逆向提炼的标准中文提示词骨架
  coverUrl      String?  // 封面参考图
  sampleImages  String?  // JSON 存储的全部参考图 URL 数组
  sourceUrl     String?  // 抓取的小红书/抖音原帖链接 (可选)
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

